facet_wrap(~ bioregion, ncol = ncol) +
scale_y_continuous(limits = c(0, 1)) +
labs(x = "Year", y = "Proportion of large crocodiles (>= 6ft)",
size = "Non-hatchlings") +
scale_size_continuous(limits = nh_limits, range = c(1, 5)) +
theme_bw() +
theme(legend.position = "bottom")
}
