facet_wrap(~ bioregion, ncol = ncol, scales = "free_y") +
labs(x = "Year", y = "Crocodile density (NH/km)",
size = "Transect km") +
scale_size_continuous(limits = km_limits, range = c(1, 5)) +
theme_bw() +
theme(legend.position = "bottom")
