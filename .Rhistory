# Define binomial glm
fit_prop <- function(df) {
glm(prop_large ~ I(year - 2021),
family = quasibinomial(link = make.link("identity")),
weights = nh,
start = c(weighted.mean(df$prop_large, df$nh), 0),
data = df)
}
